# Electriz — .gitignore
# Rappel : un seul motif par ligne, et « # » ne commence un commentaire
# qu'en début de ligne (https://git-scm.com/docs/gitignore).

# --- Python ---
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/
.pytest_cache/

# --- Environnements ---
.venv/
venv/
env/
.env
.cache/

# --- Éditeurs / OS ---
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~
.DS_Store
.ipynb_checkpoints/

# --- Données (bases PGN, datasets : plusieurs Go) ---
data/raw/
data/processed/
*.pgn
*.pgn.zst
*.binpack

# --- Modèles / réseaux ---
nets/
*.pt
*.pth
*.bin
*.weights
*.nnue

# --- Sorties du moteur ---
echiquier.svg
*.log
